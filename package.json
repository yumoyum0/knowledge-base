{
    "name":  "knowledge-base",
    "version":  "0.1.0",
    "description":  "Minimal Electron knowledge-base app",
    "main":  "src/main/main.js",
    "scripts":  {
                    "start":  "electron .",
                    "test":  "node test.js",
                    "lint":  "eslint src/main/main.js src/preload/preload.js src/renderer/renderer.js test.js",
                    "check-arch":  "node scripts/check-arch.mjs",
                    "verify":  "npm run lint && npm run check-arch && npm test"
                },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "electron":  "^33.0.0",
                            "eslint":  "^10.3.0"
                        },
    "engines":  {
                    "node":  ">=24.0.0"
                }
}